# Copy this file to ".env" in the project root and fill in your local MySQL password.
# The app loads .env from the working directory (project root when you run mvn javafx:run).
# Do not commit .env — it is listed in .gitignore.
#
# Precedence: JVM -D / OS env / this file / database.properties on classpath / built-in defaults.

SENTENCE_BUILDER_DB_URL=jdbc:mysql://localhost:3306/sentence_builder?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SENTENCE_BUILDER_DB_USER=root
SENTENCE_BUILDER_DB_PASSWORD=
